rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidQuestion(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.code is string && data.code.size() <= 64 &&
             data.type in ['pilihan_ganda', 'pilihan_ganda_kompleks', 'benar_salah', 'menjodohkan', 'isian_singkat', 'esai'] &&
             data.status in ['draft', 'menunggu_review', 'disetujui', 'perlu_revisi', 'ditolak'] &&
             data.subtest is string && data.subtest.size() <= 128 &&
             data.topic is string && data.topic.size() <= 128 &&
             data.difficulty in ['mudah', 'sedang', 'sulit'] &&
             data.prompt is string &&
             data.createdById is string && data.createdById.size() <= 128 &&
             data.createdByName is string && data.createdByName.size() <= 128 &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.role in ['pembuat', 'reviewer', 'admin'];
    }

    function isValidAuditLog(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.timestamp is string &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 128 &&
             data.userRole in ['pembuat', 'reviewer', 'admin'] &&
             data.action is string && data.action.size() <= 64 &&
             data.description is string && data.description.size() <= 500;
    }

    function isValidNotification(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.timestamp is string &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 128 &&
             data.message is string && data.message.size() <= 500 &&
             data.type in ['info', 'success', 'warning', 'error'] &&
             data.read is bool;
    }

    function isValidCategory(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.description is string && data.description.size() <= 500;
    }

    function isValidPacket(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.code is string && data.code.size() <= 64 &&
             data.title is string && data.title.size() <= 200 &&
             data.subtest is string && data.subtest.size() <= 128 &&
             data.questionIds is list;
    }

    function isValidSetting(data) {
      return data.id is string && data.id.size() <= 128;
    }

    // Questions collection
    match /questions/{questionId} {
      allow read: if true;
      allow create: if isValidId(questionId) && isValidQuestion(incoming());
      allow update: if isValidId(questionId) && isValidQuestion(incoming());
      allow delete: if isValidId(questionId);
    }

    // Question Packets collection
    match /question_packets/{packetId} {
      allow read: if true;
      allow create: if isValidId(packetId) && isValidPacket(incoming());
      allow update: if isValidId(packetId) && isValidPacket(incoming());
      allow delete: if isValidId(packetId);
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidId(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId);
    }

    // Audit Logs collection
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidAuditLog(incoming());
      allow update: if false; // Audit logs are immutable
      allow delete: if false;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isValidId(notificationId) && isValidNotification(incoming());
      allow update: if isValidId(notificationId) && isValidNotification(incoming());
      allow delete: if isValidId(notificationId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isValidId(categoryId);
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow create: if isValidId(settingId) && isValidSetting(incoming());
      allow update: if isValidId(settingId) && isValidSetting(incoming());
      allow delete: if isValidId(settingId);
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
