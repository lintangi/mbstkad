rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Questions collection
    match /questions/{questionId} {
      allow read: if true;
      allow create, update: if isValidId(questionId);
      allow delete: if isValidId(questionId);
    }

    // Question Packets collection
    match /question_packets/{packetId} {
      allow read: if true;
      allow create, update: if isValidId(packetId);
      allow delete: if isValidId(packetId);
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isValidId(userId);
    }

    // Audit Logs collection
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId);
      allow update, delete: if false;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isValidId(notificationId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isValidId(categoryId);
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

